{
  "opencollection": "1.0.0",
  "info": {
    "name": "Bloomberg EMSX Trading Brokers Teams API",
    "version": "1.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Teams",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "Bloomberg EMSX List EMSX teams",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.bloomberg.com/emsxapi/v1/teams"
          },
          "docs": "Retrieve a list of EMSX trading teams that the authenticated user has access to."
        }
      ]
    }
  ],
  "bundled": true
}